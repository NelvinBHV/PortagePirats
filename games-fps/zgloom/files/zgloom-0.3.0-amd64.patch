+static SDL_Rect GetAspectFitRect(int contentwidth, int contentheight, int targetwidth, int targetheight)
+{
+	double scale = std::min(
+		static_cast<double>(targetwidth) / contentwidth,
+		static_cast<double>(targetheight) / contentheight
+	);
+
+	SDL_Rect rect;
+	rect.w = std::max(1, static_cast<int>(std::lround(contentwidth * scale)));
+	rect.h = std::max(1, static_cast<int>(std::lround(contentheight * scale)));
+	rect.x = (targetwidth - rect.w) / 2;
+	rect.y = (targetheight - rect.h) / 2;
+
+	return rect;
+}
 
