 #include "gloommaths.h"
 #include "objectgraphics.h"
 #include "config.h"
+#include <algorithm>
+
+static uint8_t ClampByte(int value)
+{
+	if (value < 0) return 0;
+	if (value > 255) return 255;
+	return static_cast<uint8_t>(value);
+}
+
+static uint32_t SampleHDTexture(const std::vector<uint32_t>& pixels, int width, int height, int x, int y)
+{
+	if (pixels.empty() || width <= 0 || height <= 0)
+	{
+		return 0;
+	}
+
+	x %= width;
+	y %= height;
+
+	if (x < 0) x += width;
+	if (y < 0) y += height;
+
+	return pixels[static_cast<size_t>(y) * width + x];
+}
+
+static uint32_t SampleHDTextureLinear(const std::vector<uint32_t>& pixels, int width, int height, int32_t x_fp, int32_t y_fp)
+{
+	if (pixels.empty() || width <= 0 || height <= 0)
+	{
+		return 0;
+	}
+
+	int32_t w_fp = width << 16;
+	int32_t h_fp = height << 16;
+
+	x_fp %= w_fp;
+	y_fp %= h_fp;
+
+	if (x_fp < 0) x_fp += w_fp;
+	if (y_fp < 0) y_fp += h_fp;
+
+	int x0 = x_fp >> 16;
+	int y0 = y_fp >> 16;
+	int x1 = (x0 + 1) % width;
+	int y1 = (y0 + 1) % height;
+
+	int fx = (x_fp >> 8) & 0xFF;
+	int fy = (y_fp >> 8) & 0xFF;
+	int ifx = 256 - fx;
+	int ify = 256 - fy;
+
+	uint32_t c00 = pixels[static_cast<size_t>(y0) * width + x0];
+	uint32_t c10 = pixels[static_cast<size_t>(y0) * width + x1];
+	uint32_t c01 = pixels[static_cast<size_t>(y1) * width + x0];
+	uint32_t c11 = pixels[static_cast<size_t>(y1) * width + x1];
+
+	int w00 = ifx * ify;
+	int w10 = fx * ify;
+	int w01 = ifx * fy;
+	int w11 = fx * fy;
+
+	int a =
+		((static_cast<int>((c00 >> 24) & 0xFF) * w00) +
+		 (static_cast<int>((c10 >> 24) & 0xFF) * w10) +
+		 (static_cast<int>((c01 >> 24) & 0xFF) * w01) +
+		 (static_cast<int>((c11 >> 24) & 0xFF) * w11)) >> 16;
+
+	int r =
+		((static_cast<int>((c00 >> 16) & 0xFF) * w00) +
+		 (static_cast<int>((c10 >> 16) & 0xFF) * w10) +
+		 (static_cast<int>((c01 >> 16) & 0xFF) * w01) +
+		 (static_cast<int>((c11 >> 16) & 0xFF) * w11)) >> 16;
+
+	int g =
+		((static_cast<int>((c00 >> 8) & 0xFF) * w00) +
+		 (static_cast<int>((c10 >> 8) & 0xFF) * w10) +
+		 (static_cast<int>((c01 >> 8) & 0xFF) * w01) +
+		 (static_cast<int>((c11 >> 8) & 0xFF) * w11)) >> 16;
+
+	int b =
+		((static_cast<int>(c00 & 0xFF) * w00) +
+		 (static_cast<int>(c10 & 0xFF) * w10) +
+		 (static_cast<int>(c01 & 0xFF) * w01) +
+		 (static_cast<int>(c11 & 0xFF) * w11)) >> 16;
+
+	return (ClampByte(a) << 24) | (ClampByte(r) << 16) | (ClampByte(g) << 8) | ClampByte(b);
+}
+
+static uint32_t ApplyAtmosphere(uint32_t colour, int z, bool emissive)
+{
+	uint8_t r = (colour >> 16) & 0xFF;
+	uint8_t g = (colour >> 8) & 0xFF;
+	uint8_t b = colour & 0xFF;
+
+	int fog = (z - 1600) / 110;
+	if (fog < 0) fog = 0;
+	if (fog > 96) fog = 96;
+
+	const uint8_t fog_r = 8;
+	const uint8_t fog_g = 18;
+	const uint8_t fog_b = 20;
+
+	r = ClampByte(((int)r * (256 - fog) + fog_r * fog) >> 8);
+	g = ClampByte(((int)g * (256 - fog) + fog_g * fog) >> 8);
+	b = ClampByte(((int)b * (256 - fog) + fog_b * fog) >> 8);
+
+	int brightness = std::max({r, g, b});
+	if (emissive && brightness > 150)
+	{
+		int boost = std::min(56, (brightness - 150) / 2 + 18);
+		r = ClampByte(r + boost);
+		g = ClampByte(g + boost / 2);
+		b = ClampByte(b + boost);
+	}
+
+	return (r << 16) | (g << 8) | b;
+}
 
