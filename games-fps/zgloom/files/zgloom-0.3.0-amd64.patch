 #include "config.h"
 #include "objectgraphics.h"
 #include "gloommaths.h"
+#include "hdassets.h"
+#include <algorithm>
+
+static SDL_Surface* CreateSurfaceFromPixels(int width, int height, const std::vector<uint32_t>& pixels)
+{
+	SDL_Surface* surface = SDL_CreateRGBSurface(0, width, height, 32, 0x00FF0000, 0x0000FF00, 0x000000FF, 0xFF000000);
+
+	if (!surface)
+	{
+		return nullptr;
+	}
+
+	for (int y = 0; y < height; y++)
+	{
+		for (int x = 0; x < width; x++)
+		{
+			uint32_t pixel = pixels[x + y * width];
+			uint8_t alpha = static_cast<uint8_t>(pixel >> 24);
+			uint32_t color = pixel & 0x00FFFFFF;
+
+			((uint32_t*)surface->pixels)[x + y * (surface->pitch / 4)] = alpha ? (0xFF000000 | color) : 0;
+		}
+	}
+
+	return surface;
+}
+
+static bool ReplaceSurfaceFromPNG(SDL_Surface*& surface, const std::string& path)
+{
+	int width = 0;
+	int height = 0;
+	std::vector<uint32_t> pixels;
+
+	if (!HDAssets::LoadPNG(path, width, height, pixels))
+	{
+		return false;
+	}
+
+	SDL_Surface* replacement = CreateSurfaceFromPixels(width, height, pixels);
+
+	if (!replacement)
+	{
+		return false;
+	}
+
+	SDL_FreeSurface(surface);
+	surface = replacement;
+	return true;
+}
 
