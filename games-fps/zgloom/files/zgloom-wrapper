#!/bin/sh

set -eu

data_src=${ZGLOOM_DATA_DIR:-/usr/share/games/zgloom}
runtime_root=${XDG_DATA_HOME:-"${HOME}/.local/share"}/zgloom

mkdir -p "${runtime_root}"
mkdir -p "${runtime_root}/hd"

for entry in maps misc objs pics sfxs txts; do
	target="${runtime_root}/${entry}"

	if [ ! -e "${target}" ]; then
		ln -s "${data_src}/${entry}" "${target}"
	fi
done

for entry in effects misc objs pics txts; do
	target="${runtime_root}/hd/${entry}"

	if [ ! -e "${target}" ] && [ -d "${data_src}/hd/${entry}" ]; then
		ln -s "${data_src}/hd/${entry}" "${target}"
	fi
done

if [ -f "${data_src}/hd/README.txt" ] && [ ! -f "${runtime_root}/hd/README.txt" ]; then
	cp "${data_src}/hd/README.txt" "${runtime_root}/hd/README.txt"
fi

config_file="${runtime_root}/config.txt"

if [ ! -f "${config_file}" ]; then
	cat > "${config_file}" <<'EOF'
;Auto-generated by the Gentoo zgloom wrapper
rendersize 1920 1080
windowsize 1920 1080
vsync 0
fullscreen 1
focallength 960
mousesensitivity 5
bloodsize 2
sfxvol 5
musvol 5
multithread 0
autofire 0
EOF
fi

cd "${runtime_root}" || exit 1
exec /usr/libexec/zgloom/ZGloom "$@"
